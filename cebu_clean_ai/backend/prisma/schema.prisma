generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String   @id @default(cuid())
  email   String   @unique
  role    String
  points  Int      @default(0)
  rewards Reward[]
}

model SmartBin {
  id          String  @id @default(cuid())
  code        String  @unique
  barangay    String
  latitude    Float
  longitude   Float
  fillLevel   Float   @default(0)
  temperature Float   @default(0)
  status      String  @default("online")
  lastSeenAt  DateTime @default(now())
  battery     Float    @default(100)
  telemetry   Telemetry[]

  @@index([barangay])
  @@index([status])
  @@index([lastSeenAt])
}

model Reward {
  id        String   @id @default(cuid())
  label     String
  delta     Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model WasteLog {
  id         String   @id @default(cuid())
  label      String
  confidence Float
  imageUrl   String?
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  createdAt  DateTime @default(now())
}

model Telemetry {
  id          String   @id @default(cuid())
  bin         SmartBin @relation(fields: [binId], references: [id])
  binId       String
  fill        Float
  temperature Float
  battery     Float
  latitude    Float
  longitude   Float
  ts          DateTime @default(now())
  createdAt   DateTime @default(now())
  version     Int      @default(1)

  @@index([binId, ts])
}
